# ── Django core ───────────────────────────────────────────────
DJANGO_SECRET_KEY=your-django-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────
# Production (Neon): set DATABASE_URL and leave individual DB_* vars unset.
# Local dev: leave DATABASE_URL empty and use DB_* vars below.
DATABASE_URL=

DB_NAME=bookstore_db
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ── CORS & CSRF ─────────────────────────────────────────────
# Comma-separated origins. Production example:
# CORS_ALLOWED_ORIGINS=https://your-app.netlify.app
# CSRF_TRUSTED_ORIGINS=https://your-app.netlify.app,https://your-api.onrender.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ── Chapa payment ───────────────────────────────────────────
CHAPA_SECRET_KEY=YOUR_CHAPA_SECRET_KEY
CHAPA_BASE_URL=https://api.chapa.co
CHAPA_VERIFY_URL=https://api.chapa.co/v1/transaction/verify/
CHAPA_RETURN_URL=http://localhost:3000/payment-result
CHAPA_CALLBACK_URL=http://localhost:8000/api/payments/webhook/
